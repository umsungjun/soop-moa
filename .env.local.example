# ──────────────────────────────────────────────────────────────────────
# SOOP-MOA 환경변수 템플릿
# ──────────────────────────────────────────────────────────────────────
# 이 파일은 git에 커밋되는 "템플릿"입니다. 실제 값은 적지 마세요.
# 사용 방법:
#   1) cp .env.local.example .env.local
#   2) .env.local 의 빈 값을 채우기
#   3) .env.local 은 .gitignore 로 보호됨
# ──────────────────────────────────────────────────────────────────────

# ── SOOP OAuth ────────────────────────────────────────────────────────
# https://developers.sooplive.co.kr/ 에서 발급
# NEXT_PUBLIC_ 접두사는 클라이언트 번들에 포함됨 → public 값만 사용

# 로컬 개발용 Client ID (브라우저 노출 OK — Redirect URI로 보호됨)
NEXT_PUBLIC_SOOP_CLIENT_ID=

# 로컬 개발용 Client Secret (★서버 only, 절대 NEXT_PUBLIC_ 접두사 금지)
SOOP_CLIENT_SECRET=

# OAuth 콜백 URL — SOOP 콘솔에 등록한 값과 정확히 일치해야 함
# 로컬: http://localhost:3000/api/auth/callback
# 운영: https://soopmoa.vercel.app/api/auth/callback
NEXT_PUBLIC_SOOP_REDIRECT_URI=

# ── Iron Session ──────────────────────────────────────────────────────
# 세션 쿠키 암호화 키 (32자 이상의 랜덤 문자열 필수)
# 생성:  openssl rand -base64 32
IRON_SESSION_PASSWORD=

# ── Site Metadata ─────────────────────────────────────────────────────
# SEO / OG 절대경로 생성에 사용
# 로컬: http://localhost:3000
# 운영: https://soopmoa.vercel.app
NEXT_PUBLIC_SITE_URL=

# ── Supabase (커뮤니티 게시판) ─────────────────────────────────────────
# Supabase 프로젝트 생성 후 supabase/migrations/0001_community.sql 실행
# Project Settings → API 에서 값 확인 (신규 프로젝트는 API Keys 탭의
# sb_publishable_.../sb_secret_... 키일 수 있음 — 매핑 동일)

# 프로젝트 URL (공개 OK): https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# service_role 키 (★서버 only, 절대 NEXT_PUBLIC_ 금지) — RLS를 우회하는 관리자 키
SUPABASE_SERVICE_ROLE_KEY=

# anon/publishable 공개키 (선택, MVP 미사용 — 향후 클라이언트 직접 read용)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Vercel Cron (선택) ────────────────────────────────────────────────
# 무료 티어 7일 자동 일시정지 회피용 heartbeat 보호 토큰
# 생성: openssl rand -base64 32  / Vercel 프로젝트 env에도 동일 등록
CRON_SECRET=
